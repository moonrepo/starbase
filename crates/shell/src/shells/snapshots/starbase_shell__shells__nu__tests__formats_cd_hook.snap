---
source: crates/shell/src/shells/nu.rs
expression: Nu.format_hook(hook).unwrap()
---
export def _starbase_hook [] {
    let data = starbase hook nu | from json

    $data | get --optional env | items { |k, v|
        if $v == null {
            if $k in $env {
                hide-env $k
            }
        } else {
            load-env { ($k): $v }
        }
    }

    let path_list = $data | get --optional paths | default []
    let path_string = $data | get --optional path | default ''

    if ($path_list | is-not-empty) {
        $env.PATH = $path_list
    }

    if ($path_string | is-not-empty) {
        $env.PATH = $path_string
    }
}

export-env {
    $env.__ORIG_PATH = $env.PATH

    $env.config = ($env.config | upsert hooks.env_change.PWD { |config|
        let list = ($config | get --optional hooks.env_change.PWD) | default []

        $list | append { |before, after|
            _starbase_hook
        }
    })
}
