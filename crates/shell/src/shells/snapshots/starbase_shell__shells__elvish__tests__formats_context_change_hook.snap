---
source: crates/shell/src/shells/elvish.rs
expression: Elvish.format_hook(hook).unwrap()
---
fn _starbase_hook {|@_|
  eval (starbase hook elvish | slurp)
}

fn _starbase_deactivate {
  eval (starbase deactivate elvish | slurp)
  set after-chdir = [(each {|hook| if (not (and (has-key $hook def) (eq $hook[def] $_starbase_hook~[def]))) { put $hook } } $after-chdir)]
  try {
    eval &ns=(ns [&activate~=$_starbase_hook~]) 'set edit:before-readline = [(each {|hook| if (not (and (has-key $hook def) (eq $hook[def] $activate~[def]))) { put $hook } } $edit:before-readline)]'
    edit:del-vars ['_starbase_hook~' '_starbase_deactivate~']
  } catch _ {
    # Nothing was registered or exported when non-interactive
  }
}

set after-chdir = [(each {|hook| if (not (and (has-key $hook def) (eq $hook[def] $_starbase_hook~[def]))) { put $hook } } $after-chdir)]
set @after-chdir = $@after-chdir $_starbase_hook~

# The prompt trigger lives in the `edit:` module, which only exists in an
# interactive session. Referencing it directly is a compilation error, which
# `try` cannot catch, so the registration is compiled at runtime by `eval`
try {
  eval &ns=(ns [&activate~=$_starbase_hook~]) 'set edit:before-readline = [(each {|hook| if (not (and (has-key $hook def) (eq $hook[def] $activate~[def]))) { put $hook } } $edit:before-readline)]
set @edit:before-readline = $@edit:before-readline $activate~'
} catch _ {
  # The `edit:` module only exists in an interactive session
}

# Consumers `eval` this code, which runs in a restricted namespace, so export
# both functions for the interactive session to be able to call them
try {
  edit:add-vars [&'_starbase_hook~'=$_starbase_hook~ &'_starbase_deactivate~'=$_starbase_deactivate~]
} catch _ {
  # The `edit:` module only exists in an interactive session
}
