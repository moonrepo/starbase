---
source: crates/shell/src/shells/murex.rs
expression: Murex.format_hook(hook).unwrap()
---
function _starbase_hook {
  starbase hook murex -> source
}

function _starbase_deactivate {
  starbase deactivate murex -> source
  !event onPrompt _starbase_hook
  !function _starbase_hook
  !function _starbase_deactivate
}

event onPrompt _starbase_hook=before {
  _starbase_hook
}
