---
source: crates/shell/src/shells/elvish.rs
expression: "Elvish.format_hook(Hook::RegisterHandlers\n{ function: \"_starbase_hook\".into(), }).unwrap()"
---
# Re-sourcing creates a new function object every time, so a registered handler
# is matched by its body rather than by identity
fn _starbase_hook_on_chdir {|handlers|
  each {|handler| if (not (and (has-key $handler def) (eq $handler[def] $_starbase_hook~[def]))) { put $handler } } $handlers
}

set @after-chdir = (_starbase_hook_on_chdir $after-chdir) $_starbase_hook~

# The prompt trigger lives in the `edit:` module, which only exists in an
# interactive session. Referencing it directly is a compilation error, which
# `try` cannot catch, so the registration is compiled at runtime by `eval`
try {
  eval &ns=(ns [&others~=$_starbase_hook_on_chdir~ &activate~=$_starbase_hook~]) 'set @edit:before-readline = (others $edit:before-readline) $activate~'
} catch _ {
  # The `edit:` module only exists in an interactive session
}
