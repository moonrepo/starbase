---
source: crates/shell/src/shells/fish.rs
expression: Fish.format_hook(hook).unwrap()
---
function _starbase_hook --on-variable PWD --on-event fish_prompt;
  starbase hook fish | source
end;

function _starbase_deactivate;
  starbase deactivate fish | source
  functions --erase _starbase_hook _starbase_deactivate
end;
