---
source: crates/shell/src/shells/bash.rs
expression: Bash.format_hook(hook).unwrap()
---
_starbase_hook() {
  local previous_exit_status=$?;
  local output;
  trap '' SIGINT;
  output=$(starbase hook bash)
  if [ -n "$output" ]; then
    eval "$output";
  fi
  trap - SIGINT;
  return $previous_exit_status;
};

_starbase_deactivate() {
  local output;
  output=$(starbase deactivate bash)
  if [ -n "$output" ]; then
    eval "$output";
  fi
  if [[ "$(declare -p PROMPT_COMMAND 2>&1)" == "declare -a"* ]]; then
    local filtered=();
    local entry;
    for entry in "${PROMPT_COMMAND[@]}"; do
      if [[ "$entry" != "_starbase_hook" ]]; then
        filtered+=("$entry");
      fi
    done
    PROMPT_COMMAND=("${filtered[@]}");
  else
    PROMPT_COMMAND=";${PROMPT_COMMAND:-};";
    PROMPT_COMMAND="${PROMPT_COMMAND//;_starbase_hook;/;}";
    PROMPT_COMMAND="${PROMPT_COMMAND#;}";
    PROMPT_COMMAND="${PROMPT_COMMAND%;}";
  fi
  unset -f _starbase_hook _starbase_deactivate;
};

if [[ "$(declare -p PROMPT_COMMAND 2>&1)" == "declare -a"* ]]; then
  if [[ " ${PROMPT_COMMAND[*]:-} " != *" _starbase_hook "* ]]; then
    PROMPT_COMMAND=(_starbase_hook "${PROMPT_COMMAND[@]}")
  fi
elif [[ ";${PROMPT_COMMAND:-};" != *";_starbase_hook;"* ]]; then
  PROMPT_COMMAND="_starbase_hook${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi
