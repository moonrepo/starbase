---
source: crates/shell/src/shells/xonsh.rs
expression: Xonsh.format_hook(hook).unwrap()
---
def _starbase_hook(olddir=None, newdir=None, **kwargs):
    output = $(starbase hook xonsh)
    if output:
        execx(output)

def _starbase_deactivate():
    global _starbase_hook, _starbase_deactivate
    output = $(starbase deactivate xonsh)
    if output:
        execx(output)
    for handler in list(events.on_chdir):
        if getattr(handler, '__name__', '') == '_starbase_hook':
            events.on_chdir.discard(handler)
    del _starbase_hook, _starbase_deactivate

# Re-sourcing creates new function objects, so deduplicate by name
if not any(getattr(handler, '__name__', '') == '_starbase_hook' for handler in events.on_chdir):
    events.on_chdir(_starbase_hook)
